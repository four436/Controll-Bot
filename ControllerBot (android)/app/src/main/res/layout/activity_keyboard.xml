<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".KeyboardActivity">

    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/bkBtn"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:onClick="backBtn"
            app:icon="@drawable/ic_back"
            app:iconTint="#000"/>

    </com.google.android.material.appbar.AppBarLayout>
    
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_centerVertical="true"
        android:gravity="center">
        <com.google.android.material.button.MaterialButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Releas all"
            android:id="@+id/releaseAllBtn"
            android:onClick="releaseAll"
            android:layout_marginBottom="20dp"/>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginBottom="20dp">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="Hold"
                android:textSize="20sp"
                android:layout_marginRight="10dp"/>

            <com.google.android.material.materialswitch.MaterialSwitch
                android:id="@+id/holdSw"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:foregroundTint="@color/black"
                android:onClick="holdSw"
                android:thumb="@drawable/selector_thumb"
                app:thumbTint="@color/selector_thumb_color"
                app:trackTint="@color/selector_track" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/black"
                android:text="Click"
                android:textSize="20sp"
                android:layout_marginLeft="10dp"/>
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginRight="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/esc"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="escBtn"
                    android:text="esc"
                    android:textColor="@color/black"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tab"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="tabBtn"
                    android:text="Tab"
                    android:textColor="@color/black"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/capsLock"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="capsLockBtn"
                    android:text="Caps Lock"
                    android:textColor="@color/black"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shift"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="shiftBtn"
                    android:text="Shift"
                    android:textColor="@color/black"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ctrl"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="ctrlBtn"
                    android:text="Ctrl"
                    android:textColor="@color/black"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="function buttons"/>

                <Spinner
                    android:id="@+id/functionBtnSpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dialog" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/funcBtnSp"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="functioBtnAct"
                    android:text="Press"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Letters and Numbers"/>

                <Spinner
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/letterAndNumberKeySpinner"
                    android:spinnerMode="dialog"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/letterAndNumberBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="letterAndNumberBtnAct"
                    android:text="Press"
                    android:layout_marginBottom="10dp"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Symbols"/>

                <Spinner
                    android:id="@+id/symbolKeySpinner"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:spinnerMode="dialog" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/SymbolKeyBtn"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="symbolBtnAct"
                    android:text="Press" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginLeft="20dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backspace"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="backspaceBtn"
                    android:text="Backspace"
                    android:textColor="@color/black"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/enter"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="enterBtn"
                    android:text="Enter"
                    android:textColor="@color/black"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/shift2"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="shiftBtn"
                    android:text="Shift"
                    android:textColor="@color/black"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/ctrl2"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="ctrlBtn"
                    android:text="Ctrl"
                    android:textColor="@color/black"
                    app:cornerRadius="15dp"
                    app:strokeColor="@color/black"
                    app:strokeWidth="2dp" />

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/win"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="winBtn"
                app:cornerRadius="15dp"
                app:icon="@drawable/ic_windows"
                app:iconTint="@color/black"
                app:strokeColor="@color/black"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/alt"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="altBtn"
                android:text="Alt"
                android:textColor="@color/black"
                app:cornerRadius="15dp"
                app:strokeColor="@color/black"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/space"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="spaceBtn"
                android:text="Space"
                android:textColor="@color/black"
                app:cornerRadius="15dp"
                app:strokeColor="@color/black"
                app:strokeWidth="2dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/altGr"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="altGrBtn"
                android:text="Alt Gr"
                android:textColor="@color/black"
                app:cornerRadius="15dp"
                app:strokeColor="@color/black"
                app:strokeWidth="2dp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginTop="20dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/uparrow"
                style="@style/Widget.Material3.Button.IconButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:onClick="upArrow"
                app:icon="@drawable/ic_up"/>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/leftarrow"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="leftArrow"
                    app:icon="@drawable/ic_left" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/downarrow"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="downArrow"
                    app:icon="@drawable/ic_down" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/rightarrow"
                    style="@style/Widget.Material3.Button.IconButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:onClick="rightArrow"
                    app:icon="@drawable/ic_right" />

            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

</RelativeLayout>
